# 複製成 .env 並填入真實值：cp .env.example .env
# 其他（.env、憑證、gcs 金鑰）已被 .gitignore 排除，不會進版本庫。

# Tavily 聯網搜尋（Researcher 工具）
TAVILY_API_KEY=

# Google Maps Places API (New) 與 Geocoding API
GOOGLE_MAPS_API_KEY=

# PostgreSQL 連線（含 pgvector）。例：postgresql://user:pass@localhost:5432/community
DATABASE_URL=

# Ollama 本機模型
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# 圖片儲存：gcs 或 local（gcs 失敗會自動退回 local）
STORAGE_BACKEND=local
GCS_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=

# 開發時 hot reload
UVICORN_RELOAD=1